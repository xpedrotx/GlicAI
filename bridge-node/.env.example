# Porta em que o bridge Node.js escuta (recebe pedidos de envio do backend Python)
PORT=3000

# URL do backend Python que vai receber as mensagens recebidas no WhatsApp
# Local (rodando fora do Docker): http://localhost:8000/webhook
# Produção (docker-compose): http://backend-python:8000/webhook
PYTHON_WEBHOOK_URL=http://localhost:8000/webhook

# Chave simples para autenticar as chamadas entre bridge <-> backend.
# Precisa ser IGUAL ao INTERNAL_API_KEY do backend-python/.env.
# Gere um valor aleatório antes de rodar em produção, ex: openssl rand -hex 32
INTERNAL_API_KEY=troque-esta-chave
