# Supabase
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-service-role-key

# Bridge Node.js (whatsapp-web.js)
# Local (rodando fora do Docker): http://localhost:3000
# Produção (docker-compose): http://bridge-node:3000
NODE_BRIDGE_URL=http://localhost:3000

# Precisa ser IGUAL ao INTERNAL_API_KEY do bridge-node/.env.
# Gere um valor aleatório antes de rodar em produção, ex: openssl rand -hex 32
INTERNAL_API_KEY=troque-esta-chave

# Porta do backend Python
PORT=8000

# IA (opcional). Habilita o fallback de IA: quando o paciente
# digita um comando que o bot nao reconhece, a IA tenta sugerir o comando
# certo (o bot sempre pede confirmacao antes de executar). Sem essa chave,
# esse fallback fica desativado e o bot só responde "não entendi".
ANTHROPIC_API_KEY=

# Resend (https://resend.com) - opcional. Habilita o email de alerta quando
# o banco no Supabase estiver perto do limite do plano gratuito. Sem essa
# chave, o alerta simplesmente não é enviado (só fica registrado no log).
RESEND_API_KEY=
